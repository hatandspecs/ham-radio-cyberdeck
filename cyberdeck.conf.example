# cyberdeck.conf — this station's settings.
#
# Copy to cyberdeck.conf and edit. Same form as the iGate project's files:
# KEY = value, '#' starts a comment, blank lines ignored. An unrecognized key
# is refused rather than ignored, because a typo that is silently absorbed
# becomes a setting that mysteriously does nothing.

# --- Station ---
CALLSIGN = KD3CCO
NAME = Don
QTH = State College, PA
LOCATOR = FN10cs
RIG = FTX-1
ANTENNA = 40 m EFHW at 30 ft

# The ceiling of whatever configuration you are running, in watts. hamlib
# reports the power control as a position between 0 and 1, not a wattage, so
# this is what turns the position into watts:
#
#     watts = control position x TX_POWER_MAX
#
# It is a setting rather than something looked up because the ceiling is not a
# property of the radio. On an FTX-1: 6 on the internal battery, 10 on
# external power, 100 docked in the Optima with the SPA-1 amplifier. Same
# radio, same control position, three different answers.
#
# Works on any rig hamlib can drive. 0 means do not scale.
TX_POWER_MAX = 0

# Fixed watts, used only when the radio cannot be read at all -- no CAT, or a
# rig that will not answer. 0 means record nothing rather than guess.
TX_POWER = 0

# --- Operating defaults ---
DEFAULT_MODE = BPSK31

# --- WiFi ---
# The WiFi screen (F1 7 w) can switch the radio off, and nmcli remembers that
# across a reboot. This switches it back on at every start, which is what
# makes the toggle safe to offer: with WiFi off and the Bluetooth keyboard
# flat there is no SSH, no keyboard, and the radio in the only USB port, so a
# power cycle is the only recovery — and it only recovers if WiFi returns.
#
# The toggle is therefore for this session, not the next one. Setting this to
# no removes the recovery path and there is no other way back in.
WIFI_ON_START = yes
# The audio carrier is parked here and left alone; the radio's own waterfall
# and VFO bring a signal to this offset. See design_doc.md §8.
DEFAULT_CARRIER = 1500

# --- Display ---
# matrix (green) | deckard (amber) | hal (red) | tron (cyan-blue)
COLOR = matrix
# Console font, which sets the character grid on an 800x480 panel:
#   8x16 -> 100x30 (too small to read on 5")   10x20 -> 80x24
#   12x24 -> 66x20 (proposed default)          16x32 -> 50x15
FONT = 12x24
TIMESTAMPS = yes
SCROLLBACK = 2000

# --- fldigi ---
FLDIGI_URL = http://127.0.0.1:7362/
POLL_MS = 200

# --- Safety ---
# Seconds before an over is aborted. The radio's own time-out timer is the
# real backstop; this is the software one. 0 disables it.
TX_TIMEOUT = 180

# --- Logging ---
# Off by default, and when off the feature does not exist: no key bound, no
# status field, no file created. docs/qso_log_design.md has the design.
LOGGING = no
# Blank means ~/.local/share/cyberdeck/qso.log
LOG_PATH =

# Where the logged mode comes from:
#   auto     fldigi's modem when the deck is passing traffic or the rig
#            reports a data mode; the rig's own mode otherwise. The default.
#   digital  always fldigi's modem
#   voice    always the rig, and never fldigi — what to set for an SSB
#            session on a deck with no CAT control, because `auto` leans
#            digital when it cannot read the rig
OPERATING = auto

# Activity type. Blank is general logging. Three are built in -- GENERAL,
# POTA and CONTEST. Add your own in ~/.config/cyberdeck/activities.conf -- see
# activities.conf.example. An activity is a named, ordered list of fields, and
# that list is also the entry grammar: with QSOPARTY selected, typing
# "W3ABC 123 MONT" means serial 123 and exchange MONT.
ACTIVITY =

# This station's exchange for the current activity -- a class, a county, a
# section. The same on every contact of an event, so it is a setting rather
# than something typed eighty times. This station's serial is not here: it
# increments, and it is derived from the log.
EXCHANGE_TX =

# Look up callsigns over the network. Separate from LOGGING because it sends
# every call worked to a third party. callook.info covers the US and needs no
# account; HamQTH covers the world and needs one, and is tried only when
# callook has nothing. HamQTH credentials go in cyberdeck.secrets, and its
# username is your CALLSIGN, not your email address.
CALLBOOK = no

# This station's own park or summit reference while activating. Only used by
# an activity that has a reference field (POTA, SOTA, WWFF). There is no
# separate POTA setting: POTA is an activity, selected with ACTIVITY above.
MY_PARK =

# Logbook of The World. The tqsl Station Location name for this station, which
# tqsl needs to know which callsign signed the log. Signing happens off the
# deck -- there is deliberately no certificate or passphrase setting here.
LOTW_LOCATION =
