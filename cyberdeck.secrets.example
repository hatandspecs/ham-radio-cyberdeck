# cyberdeck.secrets — credentials the running deck reads at every start.
# Copy to cyberdeck.secrets and fill in. NEVER COMMIT THAT FILE.
#
# Separate from deck.secrets, which is a different thing: that one is read on
# a laptop by build_deck_image.sh and baked into the card, so changing it
# means building a new card. This one is read by the deck itself, which is
# what a key you can regenerate needs.
#
# chmod 600. The card has no disk encryption and pulls out with a fingernail,
# so this protects against a shoulder and a shared screenshot, not against
# somebody holding the hardware.

# QRZ.com logbook API key, from your logbook's Settings tab. Uploading
# requires a QRZ subscription; without one the API answers and refuses.
# Leave blank or delete the line to turn uploading off.
QRZ_API_KEY =

# HamQTH, for callsign lookups outside the US. callook.info needs no account
# and covers the US; HamQTH needs one and covers the world, and is tried only
# when callook has nothing. Register free at hamqth.com.
HAMQTH_USER = KD3CCO
HAMQTH_PASSWORD = your-hamqth-password

# QRZ's XML callsign lookup. A DIFFERENT service from QRZ_API_KEY above, which
# is the logbook upload -- different endpoint, different credential, different
# subscription. Your account name and password.
#
# A non-subscriber gets the name and the town but usually NOT the grid square,
# which is why QRZ is tried last, after callook and HamQTH.
QRZ_USER = KD3CCO
QRZ_PASSWORD = your-qrz-account-password
