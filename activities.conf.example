# Activity types for the contact log.
#
# An activity is a named, ordered list of fields. The field list IS the entry
# grammar: with `entry = serial_rx, exchange_rx`, typing
#
#     W3ABC 123 MONT
#
# means serial 123 and exchange MONT, and the reports default. The same line
# in general logging means something else entirely -- which is the point, since
# 599 is both a valid signal report and a valid serial number and nothing
# about the token says which.
#
# Copy to ~/.config/cyberdeck/activities.conf and edit. Anything defined here
# overrides the built-in of the same name; everything else is left alone.
# Select one with ACTIVITY = <name> in cyberdeck.conf, or from the log menu.
#
# Fields an `entry` list may name, in any order:
#
#   rst_s        signal report sent          (report)
#   rst_r        signal report received      (report)
#   serial_rx    their serial number         (number)
#   exchange_rx  their exchange              (text)
#   park         THEIR park -- POTA          (reference)
#   sota         THEIR summit                (reference)
#   wwff         THEIR WWFF reference        (reference)
#   iota         THEIR island                (text)
#   my_park      YOUR park -- activating     (reference, sticky)
#   my_sota      YOUR summit                 (reference, sticky)
#   my_wwff      YOUR WWFF reference         (reference, sticky)
#   my_iota      YOUR island                 (text, sticky)
#   name         their name                  (text)
#   qth          their location              (text)
#
# Thirty-two in all; `F3` on the log screen lists every one with a line of
# help. The two SIDES are separate fields, and that is the whole difference
# between activating and hunting: take `park` to hunt, `my_park` to activate,
# both for a park-to-park. The own-side fields are sticky -- typed once per
# activation -- and `^U` on one turns that off.
#
# Use the field that matches the PROGRAM. Each exports to its own ADIF field
# (`SOTA_REF`/`MY_SOTA_REF` and so on), so a summit logged in `park` is
# written as a POTA reference.
#
# A text field takes one token, except in the LAST position where it takes the
# rest of the line -- which is how "1B EPA" is one Field Day exchange while
# "Bob Pittsburgh PA" still splits into a name and a QTH.
#
# What THIS station sends by way of an exchange is not typed per contact:
# EXCHANGE_TX is a setting in cyberdeck.conf, appearing whenever a schema takes
# `exchange_rx`, and the serial increments on its own. Your own REFERENCE is a
# field you select, and MY_PARK remembers it between sessions.
#
# Built in: GENERAL, POTA, CONTEST -- and only those three. Everything
# below is an example to copy and change, which is what `like` is for.

# A state QSO party. `like` starts from a saved activity and overrides only
# what it restates, so the field list cannot drift from its template.
[PAQP]
like = CONTEST
label = Pennsylvania QSO Party
contest_id = PA-QSO-PARTY
label_exchange_rx = County

# Serial numbers that do not start at one -- a second operating period, say.
[SPRINT]
label = Sprint, resuming
like = CONTEST
serial_start = 250

# Reports and an exchange, no serial. Sweepstakes-shaped.
[SWEEPSTAKES]
label = ARRL Sweepstakes
entry = serial_rx, exchange_rx
serial = yes
label_exchange_rx = Prec + Check + Section

# A custom order: exchange first, then the number.
[MYEVENT]
label = Exchange before number
entry = exchange_rx, serial_rx

# Hunting parks: THEIR reference and nothing of your own. No own-reference
# field on the form, and nothing asks which park you are in.
[HUNT]
label = Park hunting
entry = rst_s, rst_r, park, name

# Activating a park: YOUR reference, typed once, and no their-park column.
[ACTIVATE]
label = Park activation
entry = rst_s, rst_r, my_park, name

# Summits on the Air. `sota` and `my_sota`, NOT `park` -- each program has its
# own ADIF field on both sides, and a summit put in `park` is exported as a
# POTA reference. (`sig` is parsed and read by nothing; it is not the way to
# say "this is really SOTA".)
[SOTA]
label = Summits on the Air
entry = rst_s, rst_r, sota, my_sota, name

# World Wide Flora and Fauna, the same way.
[WWFF]
label = World Wide Flora and Fauna
entry = rst_s, rst_r, wwff, my_wwff, name

# One site in two programs: a park that is also a WWFF reference. Both own-side
# fields, each written to its own ADIF field.
[PARK-AND-WWFF]
label = Park and WWFF activation
entry = rst_s, rst_r, my_park, my_wwff, name

# Field Day: a class and a section, no serial. `exchange_rx` is last, so it
# takes the rest of the line -- "1B EPA" is one exchange, not two fields.
[FD]
label = ARRL Field Day
entry = exchange_rx
contest_id = ARRL-FIELD-DAY
label_exchange_rx = Class + Section
